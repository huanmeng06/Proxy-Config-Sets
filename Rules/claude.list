# Shared remote rule set
# Claude / Anthropic + checkout / mail / telemetry that must share the same exit
# Stripe, Proton Mail / SimpleLogin, Sift, Datadog, coffee, Persona.
# Do NOT add protonvpn.com / protonvpn.ch (standalone VPN).
# PROCESS-NAME, AND UDP REJECT, and GEOSITE stay in client configs.

# Core
DOMAIN-KEYWORD,anthropic
DOMAIN-KEYWORD,claude
DOMAIN-SUFFIX,anthropic.com
DOMAIN-SUFFIX,claude.ai
DOMAIN-SUFFIX,claude.com
DOMAIN-SUFFIX,clau.de
DOMAIN-SUFFIX,claudemcpclient.com
DOMAIN-SUFFIX,claudemcpcontent.com
DOMAIN-SUFFIX,claudeusercontent.com
DOMAIN,servd-anthropic-website.b-cdn.net
DOMAIN,anthropic.com.cdn.cloudflare.net
DOMAIN,anthropic.auth0.com
DOMAIN,anthropic-com.ghost.io

# Telemetry / fraud SDK
DOMAIN-SUFFIX,sentry.io
DOMAIN-SUFFIX,statsigapi.net
DOMAIN-SUFFIX,intercom.io
DOMAIN-SUFFIX,intercomcdn.com
DOMAIN,browser-intake-us5-datadoghq.com
DOMAIN,cdn.usefathom.com
DOMAIN-KEYWORD,datadoghq
DOMAIN-KEYWORD,datadog
DOMAIN-SUFFIX,sift.com
DOMAIN-SUFFIX,siftcience.com
DOMAIN-KEYWORD,sift

# Stripe checkout (geolocates currency from this IP)
DOMAIN-SUFFIX,stripe.com
DOMAIN-SUFFIX,stripecdn.com
DOMAIN-SUFFIX,stripe.network
DOMAIN-SUFFIX,link.com
DOMAIN-SUFFIX,hcaptcha.com

# Proton Mail / SimpleLogin hide-my-email
DOMAIN-SUFFIX,proton.me
DOMAIN-SUFFIX,protonmail.com
DOMAIN-SUFFIX,protonmail.ch
DOMAIN-SUFFIX,pm.me
DOMAIN-SUFFIX,protonweb.com
DOMAIN-SUFFIX,protonstatus.com
DOMAIN-SUFFIX,protontech.ch
DOMAIN-SUFFIX,simplelogin.io
DOMAIN-SUFFIX,simplelogin.co
DOMAIN-SUFFIX,simplelogin.com
DOMAIN-SUFFIX,simplelogin.fr
DOMAIN-SUFFIX,slmail.me
DOMAIN-SUFFIX,passmail.com
DOMAIN-SUFFIX,passmail.net
DOMAIN-SUFFIX,passinbox.com
DOMAIN-SUFFIX,passfwd.com
DOMAIN-SUFFIX,aleeas.com
